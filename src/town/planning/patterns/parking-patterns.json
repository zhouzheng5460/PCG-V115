  "patterns": [
    {
      "id": "pk_double_loaded",
      "labelZh": "双面停车排填充",
      "family": "surface_parking",
      "provenance": {
        "basisSourceIds": [
          "TF_TYPOLOGIES",
          "PARKSOLVER"
        ],
        "relationship": "derived_composition",
        "status": "TownForge-authored geometry recipe; not upstream implementation"
      },
      "implementation": {
        "state": "declarative_only",
        "preferredProvider": "placemaker_csharp_for_ab",
        "fallbackProvider": "townforge_legacy",
        "providerCapabilityMustBeProbed": true
      },
      "siteFit": {
        "acceptsIrregularPolygon": true,
        "acceptsHolesWithPreprocessing": true,
        "minAreaM2": 300,
        "shapeHint": "double_loaded"
      },
      "layout": {
        "topology": "parallel_aisles_with_cross_connectors",
        "rowMode": "two_sided",
        "placementMethod": "stripe_sweep",
        "mustConnectAllAisles": true,
        "mustReachAllStallFrontages": true,
        "entryPinned": true,
        "resolveAnglesDeg": [
          0,
          30,
          45,
          60,
          90
        ],
        "allowMultiAxis": false,
        "turnaroundRule": "prove_vehicle_clearance_or_reject",
        "greenIslands": true,
        "greenIslandRule": "at_row_ends_or_stall_group_intervals_not_across_aisle"
      },
      "parameterPolicy": {
        "stallWidthM": {
          "default": 2.5,
          "editable": true
        },
        "stallDepthM": {
          "default": 5.0,
          "editable": true
        },
        "aisleWidthM": {
          "default": 6,
          "editable": true
        },
        "landscapeIslandMinWidthM": {
          "default": 2.4,
          "editable": true
        },
        "connectorSpacingM": {
          "default": 40,
          "editable": true
        },
        "maxUnconnectedComponents": 0,
        "note": "Exploratory layout defaults only; replace with applicable local code and vehicle design constraints. Angled stalls require angle-specific geometry and one-way travel."
      },
      "operators": [
        {
          "op": "subtract_obstacles_and_holes"
        },
        {
          "op": "pick_layout_axes"
        },
        {
          "op": "reserve_entrance_and_aisle_graph",
          "args": {
            "topology": "parallel_aisles_with_cross_connectors"
          }
        },
        {
          "op": "place_stall_rows",
          "args": {
            "mode": "two_sided",
            "method": "stripe_sweep"
          }
        },
        {
          "op": "insert_landscape_islands"
        },
        {
          "op": "verify_drive_and_bay_reachability"
        },
        {
          "op": "emit_parking_geometry"
        }
      ],
      "hardChecks": [
        "entry_touches_actual_aisle",
        "every_aisle_connected",
        "every_stall_front_reachable",
        "vehicle_turn_radius_valid",
        "no_building_or_exclusion_overlap",
        "no_fake_clip_only_connectivity"
      ],
      "fallbackPatternId": "pk_single_loaded",
      "noteZh": "数据描述不意味着 Placemaker 原版自动支持此拓扑；真实产出由 A/B 测试确认。"
    },
